{
  // Node half of the build: Express server, bot runtime, lib/, scripts/, tests/.
  // Run via tsx, never bundled.
  //
  // Inherits compilerOptions from tsconfig.json but overrides module resolution
  // to NodeNext — relative imports here must carry explicit .js extensions.
  // Keep the two configs separate; see the header comment in tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "allowJs": false
  },
  "include": [
    "server.ts",
    "bot.ts",
    "lib/**/*.ts",
    "config/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "routes/**/*.ts",
    "mcp/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "ppomppu_profile",
    "scratch",
    "data",
    ".venv",
    "src"
  ]
}

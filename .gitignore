# ── Dependencies & build output ─────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.docker.example

# ── Bot runtime state ───────────────────────────────────────────────────────
# Generated by observer/publisher runs. Regenerated on every run; never a
# source of truth for anything in the repo.
activity_log.json
ppomppu_profile/

# ── Generated artifacts ─────────────────────────────────────────────────────
# artifacts/ holds publisher screenshots and traces, the competitor-intel
# SQLite database, and persisted runtime state. All of it is machine-produced
# and some of it is large (13 MB as of 2026-08-08), so none of it is versioned.
# In Docker this path is a mounted volume (ARTIFACTS_DIR=/app/data/artifacts).
artifacts/

# ── Generated / ingested data ───────────────────────────────────────────────
# Raw chat records plus the three derived outputs of the kakao pipeline:
#   kakao:ingest    -> data/kakao-processed/
#   kakao:annotate  -> data/kakao-annotated/
#   kakao:kb-export -> data/kakao-kb/
# Raw records are backed up outside the repo.
data/kakao_chat_records_*/
data/kakao-processed/
data/kakao-annotated/
data/kakao-kb/

# ── Scratch space ───────────────────────────────────────────────────────────
scratch/

# ── Test output ─────────────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
trace.*

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── MemPalace generated descriptors ─────────────────────────────────────────
# These appear inside otherwise-tracked trees (.agent/, .planning/), so they
# are matched by path rather than by a top-level rule.
**/mempalace.yaml
.agent/**/entities.json
.planning/spec-kit/**/entities.json

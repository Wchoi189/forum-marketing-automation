{
  "scope": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": []
  },
  "limits": {
    "fileLines": 40,
    "functionLines": 10
  },
  "patterns": [
    {
      "id": "coalesce-param",
      "kind": "regex",
      "regex": "COALESCE\\(\\s*\\?",
      "why": "fixture: COALESCE(?, col) drops explicit nulls"
    },
    {
      "id": "prepare-in-loop",
      "kind": "ast-grep",
      "language": "javascript",
      "why": "fixture: prepare a statement once, outside the loop (research R20 seed rule)",
      "rule": {
        "utils": {
          "in-loop": {
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "do_statement"
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "arrow_function"
                        },
                        {
                          "kind": "function_expression"
                        }
                      ]
                    },
                    {
                      "inside": {
                        "kind": "arguments",
                        "inside": {
                          "kind": "call_expression",
                          "has": {
                            "field": "function",
                            "kind": "member_expression",
                            "has": {
                              "field": "property",
                              "regex": "^(forEach|map|flatMap|filter|reduce|some|every)$"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        "rule": {
          "pattern": "$DB.prepare($$$ARGS)",
          "matches": "in-loop"
        }
      }
    },
    {
      "id": "run-outside-transaction",
      "kind": "ast-grep",
      "language": "javascript",
      "why": "fixture: a per-row .run() outside db.transaction() pays one fsync each (research R20 seed rule)",
      "rule": {
        "utils": {
          "in-loop": {
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "do_statement"
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "arrow_function"
                        },
                        {
                          "kind": "function_expression"
                        }
                      ]
                    },
                    {
                      "inside": {
                        "kind": "arguments",
                        "inside": {
                          "kind": "call_expression",
                          "has": {
                            "field": "function",
                            "kind": "member_expression",
                            "has": {
                              "field": "property",
                              "regex": "^(forEach|map|flatMap|filter|reduce|some|every)$"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        "rule": {
          "pattern": "$S.run($$$ARGS)",
          "matches": "in-loop",
          "not": {
            "inside": {
              "stopBy": "end",
              "pattern": "$DB.transaction($$$T)"
            }
          }
        },
        "constraints": {
          "S": {
            "regex": "(?i)(stmt|statement|insert|update|upsert|delete|prepare)"
          }
        }
      }
    }
  ],
  "baseline": "baseline.json",
  "receipts": "receipts"
}
